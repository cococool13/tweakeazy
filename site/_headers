# Win11 Gaming Toolkit — Cloudflare Pages response headers.
#
# Rules must not overlap. Cloudflare applies every match and concatenates
# them, so two rules setting Cache-Control on one path produce a header with
# two max-ages.
#
# /assets/* used to be public, max-age=31536000, immutable (ported from the
# old Netlify responses). Those names are not content-hashed (favicon.svg,
# hero-workstation.png). A missing file is then a 404 that browsers keep for
# a year. Short max-age, no immutable, until names are hashed.

/assets/*
  Cache-Control: public, max-age=3600

# Security headers. Netlify served none of these beyond automatic HSTS.
# Permissions-Policy matches the policy the live site already sends.
# Full Content-Security-Policy is a follow-up after fonts are self-hosted
# and the page is recovered; do not add it here.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
